# NASCE DESABILITADA. Esta rotina consome cota do plano Claude a cada execução (custo
# recorrente = porta única). Não é ligada na instalação. Para ligar, depois de você aprovar o custo:
#   systemctl --user enable --now verificador-bugs-ui.timer
# Teto semanal e custo: rotinas/README.md.
[Unit]
Description=Agentic OS — Bugs e interface (fluxos no DEV, 3 larguras, tema escuro)

[Service]
Type=oneshot
WorkingDirectory=%h
ExecStart=/usr/bin/env node %h/.claude/agentic-os/rotinas/rodar-verificador.mjs verificador-bugs-ui
TimeoutStartSec=45min
Nice=10
