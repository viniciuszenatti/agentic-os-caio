# opcional — cada execução gasta cota do plano Claude
# NASCE DESABILITADA. Esta rotina consome cota do plano Claude a cada execução (custo
# recorrente = porta única). Não é ligada na instalação. Para ligar, depois de você aprovar o custo:
#   systemctl --user enable --now verificador-seguranca.timer
# Teto semanal e custo: rotinas/README.md.
[Unit]
Description=Agentic OS — Segurança (portas, dependências, segredos, headers) dos ambientes de teste: segunda 03:00 (teto 1x por semana)

[Timer]
OnCalendar=Mon *-*-* 03:00:00
Persistent=false
RandomizedDelaySec=10min
Unit=verificador-seguranca.service

[Install]
WantedBy=timers.target
