# opcional — cada execução gasta cota do plano Claude
# NASCE DESABILITADA. Esta rotina consome cota do plano Claude a cada execução (custo
# recorrente = porta única). Não é ligada na instalação. Para ligar, depois de você aprovar o custo:
#   systemctl --user enable --now verificador-velocidade.timer
# Teto semanal e custo: rotinas/README.md.
[Unit]
Description=Agentic OS — Velocidade das páginas (Lighthouse/Web Vitals): segunda e quinta 04:00 (teto 2x por semana)

[Timer]
OnCalendar=Mon,Thu *-*-* 04:00:00
Persistent=false
RandomizedDelaySec=10min
Unit=verificador-velocidade.service

[Install]
WantedBy=timers.target
