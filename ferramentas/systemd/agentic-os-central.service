[Unit]
Description=Central de Agentes (Agentic OS, servidor local)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.claude/agentic-os/central/server.mjs
WorkingDirectory=%h/.claude/agentic-os/central
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
