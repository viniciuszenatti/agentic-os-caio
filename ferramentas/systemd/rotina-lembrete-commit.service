[Unit]
Description=Lembrete de commit: alteração rastreada parada há 24+ h nos repos da pasta de projetos (só leitura)
# Environment=AGENTIC_OS_PROJETOS=%h/Projects

[Service]
Type=oneshot
ExecStart=/usr/bin/node %h/.claude/rotinas/lembrete-commit.mjs
WorkingDirectory=%h/.claude/rotinas
Nice=10
TimeoutStartSec=300
